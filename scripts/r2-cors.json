{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://x-board-alpha.vercel.app"
        ],
        "methods": ["GET", "PUT", "HEAD", "OPTIONS"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Type", "Content-Length"],
      "maxAgeSeconds": 3600
    }
  ]
}
